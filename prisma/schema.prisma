generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==============================
// ENUMS
// ==============================

enum UserRole {
  USER
  ADMIN
}

enum SpeechStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum FileType {
  TXT
  PDF
  DOCX
}

enum SubscriptionPlan {
  FREE
  PRO
  ENTERPRISE
}

// ==============================
// USER
// ==============================

model User {
  id           String           @id @default(uuid())
  name         String
  email        String           @unique
  passwordHash String
  role         UserRole         @default(USER)
  plan         SubscriptionPlan @default(FREE)

  isActive     Boolean          @default(true)
  isVerified   Boolean          @default(false)

  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  sessions     Session[]
  speeches     SpeechGeneration[]
  favorites    Favorite[]
  files        UploadedFile[]
  usageRecords UsageRecord[]
  passwordResetTokens PasswordResetToken[]

  @@index([email])
  @@index([createdAt])
}

// ==============================
// LOGIN SESSIONS / REFRESH TOKENS
// ==============================

model Session {
  id           String   @id @default(uuid())
  userId       String
  refreshToken String   @unique

  expiresAt    DateTime
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ==============================
// TTS VOICE CATALOG
// ==============================

model Voice {
  id          String   @id @default(uuid())

  provider    String
  providerId  String
  name        String
  language    String
  languageCode String
  gender      String?
  description String?

  isActive    Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  speeches   SpeechGeneration[]

  @@unique([provider, providerId])
  @@index([languageCode])
  @@index([provider])
}

// ==============================
// SPEECH GENERATION / HISTORY
// ==============================

model SpeechGeneration {
  id          String        @id @default(uuid())

  userId      String
  voiceId     String?

  text        String
  language    String
  speed       Float         @default(1.0)
  pitch       Float         @default(0.0)
  volume      Float         @default(1.0)

  audioUrl    String?
  audioKey    String?
  duration    Float?

  status      SpeechStatus  @default(PENDING)
  errorMessage String?

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  voice       Voice?        @relation(fields: [voiceId], references: [id], onDelete: SetNull)
  favorite    Favorite?

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

// ==============================
// FAVORITES
// ==============================

model Favorite {
  id          String            @id @default(uuid())

  userId      String
  speechId    String            @unique

  createdAt   DateTime          @default(now())

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  speech      SpeechGeneration  @relation(fields: [speechId], references: [id], onDelete: Cascade)

  @@unique([userId, speechId])
  @@index([userId])
}

// ==============================
// UPLOADED FILES
// ==============================

model UploadedFile {
  id          String    @id @default(uuid())

  userId      String

  originalName String
  storageKey   String
  fileUrl      String?

  fileType    FileType
  mimeType    String
  fileSize    Int

  extractedText String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([fileType])
  @@index([createdAt])
}

// ==============================
// USAGE TRACKING
// ==============================

model UsageRecord {
  id              String   @id @default(uuid())

  userId          String

  date            DateTime @default(now())
  charactersUsed  Int      @default(0)
  speechCount     Int      @default(0)
  audioSeconds    Float    @default(0)

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}